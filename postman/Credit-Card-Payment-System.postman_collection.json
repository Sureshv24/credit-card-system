{
  "info": {
    "name": "Credit Card Payment System",
    "description": "Postman collection for the Credit Card Payment System assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "django_base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "fastapi_base_url",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "username",
      "value": "suresh"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "admin_username",
      "value": "admin"
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "email",
      "value": "suresh@example.com"
    },
    {
      "key": "card_number",
      "value": "4111111111111111"
    },
    {
      "key": "card_type",
      "value": "credit"
    },
    {
      "key": "expiry_month",
      "value": "12"
    },
    {
      "key": "expiry_year",
      "value": "2030"
    },
    {
      "key": "card_id",
      "value": "1"
    },
    {
      "key": "payment_id",
      "value": "1"
    },
    {
      "key": "payment_amount",
      "value": "500.00"
    },
    {
      "key": "status",
      "value": "SUCCESS"
    },
    {
      "key": "min_amount",
      "value": "100"
    },
    {
      "key": "max_amount",
      "value": "1000"
    },
    {
      "key": "start_date",
      "value": "2026-01-01"
    },
    {
      "key": "end_date",
      "value": "2026-12-31"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "admin_access_token",
      "value": ""
    },
    {
      "key": "admin_refresh_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_base_url}}/api/auth/register/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_base_url}}/api/auth/login/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.access) pm.collectionVariables.set('access_token', json.access);",
                  "if (json.refresh) pm.collectionVariables.set('refresh_token', json.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_base_url}}/api/auth/login/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login successful', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.access) pm.collectionVariables.set('admin_access_token', json.access);",
                  "if (json.refresh) pm.collectionVariables.set('admin_refresh_token', json.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_base_url}}/api/auth/me/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_base_url}}/api/auth/token/refresh/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token refresh successful', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.access) pm.collectionVariables.set('access_token', json.access);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_base_url}}/api/auth/logout/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Cards",
      "item": [
        {
          "name": "List Saved Cards",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_base_url}}/api/cards/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Add Card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{django_base_url}}/api/cards/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_number\": \"{{card_number}}\",\n  \"card_type\": \"{{card_type}}\",\n  \"expiry_month\": \"{{expiry_month}}\",\n  \"expiry_year\": \"{{expiry_year}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Card created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('card_id', String(json.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Card",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{django_base_url}}/api/cards/{{card_id}}/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payments (FastAPI)",
      "item": [
        {
          "name": "Create Payment (PENDING)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{fastapi_base_url}}/payments/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"amount\": \"{{payment_amount}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('payment_id', String(json.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{fastapi_base_url}}/payments/{{payment_id}}/process"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_base_url}}/api/transactions/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{django_base_url}}/api/transactions/?status={{status}}&min_amount={{min_amount}}&max_amount={{max_amount}}&start_date={{start_date}}&end_date={{end_date}}",
              "query": [
                {
                  "key": "status",
                  "value": "{{status}}"
                },
                {
                  "key": "min_amount",
                  "value": "{{min_amount}}"
                },
                {
                  "key": "max_amount",
                  "value": "{{max_amount}}"
                },
                {
                  "key": "start_date",
                  "value": "{{start_date}}"
                },
                {
                  "key": "end_date",
                  "value": "{{end_date}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Dashboard",
      "item": [
        {
          "name": "Admin Summary",
          "request": {
            "method": "GET",
